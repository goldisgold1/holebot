{
	email {$ACME_EMAIL}
}

# The site, sign-in pages and invite links, and the API. One Worker serves both hosts.
{$SITE_DOMAIN}, {$API_DOMAIN} {
	log {
		output file /data/bot-access.log
	}
	@internal path /__scheduled* /cdn-cgi/*
	respond @internal 404
	# The phone app built for the web (deploy/vps/build-mobile-web.sh), at /m on the site.
	redir /m /m/
	# Temporary: the /m page reports its console here while the phone build is debugged.
	handle /m/__log {
		respond 204
	}
	handle /m/* {
		root * /srv
		encode zstd gzip
		# Bundles under _expo are content-hashed; the page itself must never be cached, or a phone keeps
		# an old page that points at bundles a rebuild deleted (a blank screen).
		@page not path /m/_expo/*
		header @page Cache-Control "no-cache"
		@bundle path /m/_expo/*
		header @bundle Cache-Control "public, max-age=31536000, immutable"
		try_files {path} {path}.html /m/index.html
		file_server
	}
	# hole.fm bot wakes, signed and passed to OpenBot webhook routines.
	handle /hook/* {
		reverse_proxy wake-bridge:8790
	}
	# The team relay: Claude and Grok bots message each other through the same bridge.
	handle /relay/* {
		reverse_proxy wake-bridge:8790
	}
	reverse_proxy auth-api:3100
}

# Signal: WebSocket relay, Slack/Discord/Telegram webhooks. TLS ends here, so remote-api runs without it.
{$SIGNAL_DOMAIN} {
	@internal path /internal/* /metrics*
	respond @internal 404
	reverse_proxy remote-api:8443
}
